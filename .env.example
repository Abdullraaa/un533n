# Copy to .env and fill in. .env is gitignored.

# Server
PORT=3002
NODE_ENV=development

# Secrets — generate your own, e.g. `openssl rand -hex 32`
SESSION_SECRET=
JWT_SECRET=

# Database (MySQL/MariaDB, schema from un533n_v2.sql)
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=un533n

# Stripe — test-mode keys from your Stripe dashboard.
# STRIPE_PUBLISHABLE_KEY is injected into the client bundle at build time,
# so the bundle must be rebuilt after changing it.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
